// pipeline —— Ogg → WAV 转码管线
//
// 这是模块里**唯一**引入三方依赖的包：容器层（ogg/、wav/）刻意保持零依赖，
// 因为容器格式的正确性必须能被独立验证，不该被解码器的实现缺陷掩盖。
//
// 但转码不可能自己写解码器 —— 那不是本项目的方向。所以把依赖隔离在这一层：
// 上游用本项目的 ogg/ 拆包与识别编码格式，解码交给生态里已有的纯 MoonBit
// 解码器（LL728/moonopus、LL728/moonvorbis，均无 FFI），下游再用本项目的
// wav/ 编码落盘。容器层的进出两端都在自己手里，中间这段是别人的。
//
// 依赖边界清楚之后，一旦某个解码器出问题，能一眼看出责任在哪一侧。

import {
  "moonmux/ogg",
  "moonmux/codec",
  "moonmux/wav",
  "LL728/moonopus",
  "LL728/moonvorbis",
}
