# MoonBit 构建产物
_build/
target/
.mooncakes/

# 工具链生成的包接口快照（每次构建都会重新生成）
pkg.generated.mbti

# 编译输出
*.wasm
*.exe
*.dll

# 临时测试产物
# 复核、演示、手工验证时产生的中间文件一律以下划线开头命名：
# 单个文件如 _m1.ogg，目录如 _ma/、_mb/、_mc/。
# 命名约定本身就是第一道防线（与源码一眼可分），这里再加一道忽略规则兜底。
_*.ogg
_*.wav
_*.bin
_*/

# 编辑器与系统文件
.DS_Store
Thumbs.db
.vscode/

# 本机专用目录（只留在本机，不进仓库）
.workbuddy/
smoke.*/  
