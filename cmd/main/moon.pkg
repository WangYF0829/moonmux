// cmd/main —— 命令行入口
//
// 这一层只做 I/O 与排版：解析出的命令执行出来，把结果打到 stdout。
// 参数怎么解释、用法文本长什么样，全在 cli/ 里（纯逻辑、可离线断言）；
// 容器怎么解析、怎么封装，全在 ogg/ 与 wav/ 里。

import {
  "WangYF0829/moonmux",
  "WangYF0829/moonmux/cli",
  "WangYF0829/moonmux/ogg",
  "WangYF0829/moonmux/wav",
  "WangYF0829/moonmux/codec",
  "WangYF0829/moonmux/manifest",
  "WangYF0829/moonmux/pipeline",
  "moonbitlang/x/fs",
  "moonbitlang/core/env",
  "moonbitlang/x/sys",
}

supported_targets = "native"

pkgtype(kind: "executable")
